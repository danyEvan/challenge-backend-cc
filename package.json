{
  "name": "challenge-backend-cc",
  "version": "1.0.0",
  "description": "Backend challenge for Senior Backend Developer position at Cocos Capital",
  "author": "Daniel Evangelisto",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": "./dist/*"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:up": "docker compose up -d --wait postgres",
    "db:up:test": "docker compose --profile test up -d --wait postgres-test",
    "db:down": "docker compose --profile test down",
    "migration:show": "npm run build && node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:show -d dist/shared/infrastructure/persistence/data-source.js",
    "migration:run": "npm run build && node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:run -d dist/shared/infrastructure/persistence/data-source.js",
    "migration:revert": "npm run build && node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:revert -d dist/shared/infrastructure/persistence/data-source.js",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:feature": "vitest run test/feature",
    "test:integration": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run test:integration",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "verify:all": "npm run verify && npm run db:up:test && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
