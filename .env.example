# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Opción 1: PostgreSQL local (npm run db:up)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://poc:poc@127.0.0.1:5432/neondb?sslmode=disable

# Opción 2: PostgreSQL remoto (configurar las credenciales de conexión en .env)
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=verify-full

# E2E usa por defecto una base separada en 127.0.0.1:5433/cocos_test.
# Para cambiarla, exportar TEST_DATABASE_URL en la shell (ver database/README.md).
