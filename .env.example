# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Opción 1: PostgreSQL Local (Docker Compose provisto en el proyecto)
DATABASE_URL=postgresql://poc:poc@localhost:5432/neondb

# Opción 2: Base remota Neon (completar en tu .env local con las credenciales provistas por email)
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
