@baseUrl = http://localhost:3000
@idempotencyKey = 11111111-1111-4111-8111-111111111111
@rejectedIdempotencyKey = 22222222-2222-4222-8222-222222222222

# Las solicitudes POST pueden crear órdenes. Ejecutarlas únicamente sobre una base local descartable.
# Para repetir una prueba desde cero, reemplazar sus UUID por otros que no existan en idempotency_records.
# En replay, comparar status y JSON, especialmente data.id y data.datetime.
# Ignorar el header HTTP Date y la hora del plugin: corresponden a cada intercambio, no a la orden.
# Los importes exactos de portfolio corresponden al seed; comprobarlos antes de ejecutar los POST.

### Application and database readiness - 200
# Ejecutar primero. Con API y PostgreSQL disponibles responde 200.
GET {{baseUrl}}/health
Accept: application/json, application/problem+json

### Search by ticker - 200
# Con el seed provisto devuelve GGAL (id 34).
GET {{baseUrl}}/instruments?search=ggal
Accept: application/json, application/problem+json

### Search by name - 200
# Busca Grupo Financiero en el nombre.
GET {{baseUrl}}/instruments?search=Grupo%20Financiero
Accept: application/json, application/problem+json

### Currency is not a tradable instrument - 200
# ARS representa efectivo interno y no forma parte del catálogo: data=[].
GET {{baseUrl}}/instruments?search=ARS
Accept: application/json, application/problem+json

### Catalog first page - 200
# Sin search lista únicamente activos negociables. Hasta 20 elementos.
GET {{baseUrl}}/instruments?limit=20&offset=0
Accept: application/json, application/problem+json

### Catalog second page - 200
# Hasta 20 elementos en data, meta.limit=20 y meta.offset=20.
GET {{baseUrl}}/instruments?limit=20&offset=20
Accept: application/json, application/problem+json

### No matches - 200
# Con el seed provisto devuelve data=[], meta.limit=20 y meta.offset=0.
GET {{baseUrl}}/instruments?search=instrumento-inexistente
Accept: application/json, application/problem+json

### Literal SQL wildcard - 200
# Busca el carácter % literal.
GET {{baseUrl}}/instruments?search=%25
Accept: application/json, application/problem+json

### Invalid pagination - 400
# Caso de error intencional: 400, limit mayor que 100.
GET {{baseUrl}}/instruments?limit=101
Accept: application/json, application/problem+json

### User portfolio - 200
# Seed: efectivo 753000.00, total 889756.00; BMA conserva -10 acciones.
GET {{baseUrl}}/users/1/portfolio
Accept: application/json, application/problem+json

### Empty portfolio - 200
# Seed: usuario existente sin movimientos; importes 0.00 y positions=[].
GET {{baseUrl}}/users/2/portfolio
Accept: application/json, application/problem+json

### Missing portfolio user - 404
# Con el seed provisto el usuario no existe.
GET {{baseUrl}}/users/2147483647/portfolio
Accept: application/json, application/problem+json

### Invalid portfolio user - 400
# El identificador debe ser entero positivo.
GET {{baseUrl}}/users/0/portfolio
Accept: application/json, application/problem+json

### Submit MARKET BUY order by amount - 201
# Calcula cantidad con floor(monto / close); con efectivo suficiente queda FILLED.
# Ejecutar este mismo bloque dos veces: la segunda respuesta debe conservar id, datetime y body.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json
Idempotency-Key: {{idempotencyKey}}

{
  "userId": 1,
  "instrumentId": 47,
  "side": "BUY",
  "type": "MARKET",
  "amount": "50000.00"
}

### Reuse MARKET BUY key with a different payload - 409
# Ejecutar después del bloque anterior. La misma clave con otro monto produce IDEMPOTENCY_CONFLICT.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json
Idempotency-Key: {{idempotencyKey}}

{
  "userId": 1,
  "instrumentId": 47,
  "side": "BUY",
  "type": "MARKET",
  "amount": "51000.00"
}

### Submit MARKET SELL order by size - 201
# Vende 10 acciones de PAMP; con tenencia suficiente queda FILLED.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json
Idempotency-Key: 33333333-3333-4333-8333-333333333333

{
  "userId": 1,
  "instrumentId": 47,
  "side": "SELL",
  "type": "MARKET",
  "size": 10
}

### Submit LIMIT BUY order by size - 201
# Requiere precio positivo; si no excede efectivo actual queda NEW.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json
Idempotency-Key: 44444444-4444-4444-8444-444444444444

{
  "userId": 1,
  "instrumentId": 31,
  "side": "BUY",
  "type": "LIMIT",
  "size": 5,
  "price": "1400.50"
}

### Submit order with insufficient cash - 201 REJECTED
# Si los fondos no alcanzan, la orden se persiste como REJECTED.
# Ejecutar este mismo bloque dos veces: la segunda respuesta conserva id, datetime y estado REJECTED.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json
Idempotency-Key: {{rejectedIdempotencyKey}}

{
  "userId": 2,
  "instrumentId": 47,
  "side": "BUY",
  "type": "LIMIT",
  "size": 1000,
  "price": "1000.00"
}

### Missing Idempotency-Key - 400
# No se crea una orden ni se inicia el caso de uso.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json

{
  "userId": 2,
  "instrumentId": 47,
  "side": "BUY",
  "type": "LIMIT",
  "size": 1000,
  "price": "1000.00"
}

### Invalid Idempotency-Key - 400
# La clave debe ser un UUID v4 y no se inicia el caso de uso.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json
Idempotency-Key: not-a-uuid

{
  "userId": 2,
  "instrumentId": 47,
  "side": "BUY",
  "type": "LIMIT",
  "size": 1000,
  "price": "1000.00"
}

### Invalid order amount (0 shares calculated) - 422
# Monto inferior al precio de una acción produce INVALID_ORDER; no se guardan orden ni clave.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json
Idempotency-Key: 55555555-5555-4555-8555-555555555555

{
  "userId": 1,
  "instrumentId": 47,
  "side": "BUY",
  "type": "MARKET",
  "amount": "100.00"
}

### Invalid order parameters (both size and amount) - 400
# El DTO rechaza el body antes del caso de uso: se exige exactamente uno entre size y amount.
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json, application/problem+json
Idempotency-Key: 66666666-6666-4666-8666-666666666666

{
  "userId": 1,
  "instrumentId": 47,
  "side": "BUY",
  "type": "MARKET",
  "size": 10,
  "amount": "5000.00"
}
